{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "kafka2306-design",
  "homepage": "https://github.com/KAFKA2306/design",
  "items": [
    {
      "name": "kafka-base",
      "type": "registry:base",
      "title": "KAFKA2306 Design Base",
      "description": "Canonical Base UI + Lucide + generated KAFKA2306 foundation styles.",
      "extends": "none",
      "config": {
        "style": "kafka-base",
        "iconLibrary": "lucide",
        "rsc": false,
        "tsx": true,
        "tailwind": {
          "baseColor": "slate",
          "css": "src/styles/globals.css"
        },
        "aliases": {
          "components": "@/components",
          "utils": "@/lib/utils",
          "ui": "@/components/ui",
          "lib": "@/lib",
          "hooks": "@/hooks"
        }
      },
      "dependencies": [
        "@base-ui/react@1.7.0",
        "lucide-react@1.39.0"
      ],
      "files": [
        {
          "path": "styles/tokens.css",
          "type": "registry:file",
          "target": "~/src/styles/tokens.css"
        },
        {
          "path": "styles/globals.css",
          "type": "registry:file",
          "target": "~/src/styles/globals.css"
        }
      ],
      "meta": {
        "tokenAuthority": "tokens/foundation.tokens.json",
        "generatedStyle": "styles/tokens.css"
      }
    }
  ]
}
