{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kafka2306:design:violation:v1",
  "title": "Design structured violation",
  "type": "object",
  "additionalProperties": false,
  "required": ["criterion", "observed", "expected", "affected_surface", "affected_state", "severity", "verification_method", "evidence"],
  "properties": {
    "criterion": {"type": "string", "minLength": 1},
    "observed": {"type": "string", "minLength": 1},
    "expected": {"type": "string", "minLength": 1},
    "affected_surface": {"type": "string", "minLength": 1},
    "affected_state": {"type": "string", "enum": ["usable", "loading", "empty", "error", "unavailable", "unverified", "all"]},
    "severity": {"type": "string", "enum": ["error", "warning", "info"]},
    "repair_hint": {"type": "string", "minLength": 1},
    "verification_method": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
